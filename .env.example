# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (used by docker-compose and by the backend)
POSTGRES_USER=murmur
POSTGRES_PASSWORD=change-me
POSTGRES_DB=murmur
# 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 ::1 first and every new connection hangs ~2 min
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# JWT access tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Login brute-force protection: this many wrong passwords per (IP, username) within the window -> wait
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# First admin, created by: uv run python -m app.cli create-admin
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me

# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:5173

# Where WAV files are saved (relative to the repo root) and the upload size limit
RECORDINGS_DIR=storage/recordings
MAX_UPLOAD_MB=10
# Recordings shorter than this are rejected with "re-record"
MIN_RECORDING_SECONDS=10

# AI analyzer: dummy (no AI opinion) or cardiophon (needs `uv sync --group ai` and the files in AI_MODEL_DIR,
# see docs/runbook.md). Missing files → the server logs it and falls back to dummy.
AI_MODEL=dummy
AI_MODEL_DIR=models

# What "today" means in admin stats
APP_TIMEZONE=Asia/Tashkent
# Newest device firmware version (what firmware/murmur/config.h says). Devices on another version show "update available".
LATEST_FIRMWARE=

# Docker demo only (docker-compose.demo.yml sets these itself): `app.cli seed-demo` creates a demo doctor and a demo
# device with this key. Leave empty on a real installation.
# DEMO_DEVICE_KEY=
# DEMO_DOCTOR_PASSWORD=

# Built web app served at "/" (relative to the repo root)
FRONTEND_DIST=frontend/dist
# Host port of the API in the Docker stacks
API_PORT=8000
# bcrypt cost (12 = about 0.2 s per login on a laptop; tests use 4)
BCRYPT_ROUNDS=12

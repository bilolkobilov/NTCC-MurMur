{
  "permissions": {
    "deny": [
      "Read(./.env)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git diff:*)",
      "Bash(uv run python -m pytest:*)",
      "Bash(uv run python -m ruff:*)",
      "Bash(docker compose ps:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|MultiEdit|NotebookRead|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
